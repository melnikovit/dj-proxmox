# Порты сервисов
DJPROXMOX_PORT=8091
PROMETHEUS_PORT=9093
GRAFANA_PORT=3003

# Учетные записи
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-pass
POSTGRES_PASSWORD=change-me-db-pass
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-pass

# Безопасность (сгенерируйте надежные случайные ключи)
JWT_SECRET=change-me-jwt-secret-key
DJPROXMOX_SECRETS_KEY=change-me-secrets-key-32bytes!!

# Публичные URL (для работы из браузера)
PUBLIC_URL=http://127.0.0.1:8091
GRAFANA_URL=http://127.0.0.1:3003
PROMETHEUS_URL=http://127.0.0.1:9093
GRAFANA_ROOT_URL=http://127.0.0.1:3003

# Параметры агентов
AGENT_VERSION=0.1.0
